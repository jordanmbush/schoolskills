---
/**
 * The page shell every route renders into.
 *
 * SEO metadata is a required prop rather than an optional slot on purpose: a
 * page that forgets its title and description is the single most common way a
 * static site quietly fails to rank, and making it a type error is cheaper
 * than catching it in review. `canonical` is derived from Astro.site (set in
 * astro.config.mjs) so it can't drift from the sitemap.
 *
 * `world` is the other required-ish decision: it stamps `data-world` on <html>
 * and every colour on the page follows from it (see src/styles/worlds.css).
 * The default is `grid` because that's the game, and an unthemed game screen
 * should land somewhere deliberate rather than somewhere blank.
 */
import type { World } from "@/engine/worlds";
import { THEME_COLOUR } from "@/engine/worlds";
import { AD_CLIENT, ADS_ENABLED } from "@/components/site/ads";

interface Props {
  title: string;
  description: string;
  /** Overrides the og:image. Defaults to the site-wide card. */
  image?: string;
  /** Structured data for this page, serialised into a JSON-LD script tag. */
  jsonLd?: Record<string, unknown>;
  /** Which world this page is in. Drives every colour on it. */
  world?: World;
  /**
   * Keep this page out of search results.
   *
   * For the game routes, which are `client:only` islands: their prerendered
   * body is two words, so there is nothing for a crawler to rank and a shelf
   * of near-empty pages is a thin-content signal against the whole domain.
   * The crawlable surface is the content pages AROUND the islands — that is
   * the split the architecture is built on, and this is the half of it that
   * was missing.
   *
   * `follow` rather than `nofollow`: the page is not worth indexing, but the
   * links out of it — to the map, to the other worlds — still are.
   *
   * Anything set here must also be excluded from the sitemap; listing a URL
   * you have told Google to ignore is a contradiction it reports back to you.
   * astro.config.mjs does that from the same list of routes.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  image = "/og-default.png",
  jsonLd,
  world = "grid",
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en" data-world={world} data-ads={ADS_ENABLED ? "on" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <!-- Tints the browser chrome to the world you're standing in. -->
    <meta name="theme-color" content={THEME_COLOUR[world]} />
    <meta name="generator" content={Astro.generator} />

    <!--
      Both faces are above the fold on every page: the headline is Lilita, the
      first paragraph under it is Nunito. Preloading them is what stops the
      swap landing after the reader has already started, which on a page whose
      whole job is a first impression is worth two requests.
    -->
    <link
      rel="preload"
      href="/fonts/lilita-one-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/nunito-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!--
      Registered on `load` rather than immediately: service-worker registration
      competes with the page's own resources for bandwidth, and nothing here
      needs it during first paint. Failure is silent on purpose — the site works
      perfectly without one, so a registration error is not worth a console
      error on every visit.
    -->
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>

    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    {
      /*
       * Google AdSense.
       *
       * NON-PERSONALISED, ALWAYS. This site is directed to children, so
       * behavioural advertising here would need verifiable parental consent
       * that a free static site cannot obtain — see src/components/site/ads.ts
       * for the COPPA and AdSense-policy reasoning, and /privacy for what we
       * tell parents.
       *
       * The order of these two tags is the whole point. `requestNonPersonalized
       * Ads` has to be set on the queue BEFORE the loader executes, because the
       * loader reads it when it initialises; putting the async script first
       * would leave a race in which the first ad request of a visit could go
       * out personalised. Inline, synchronous, first.
       *
       * `is:inline` on both: Astro would otherwise bundle and hoist them, which
       * breaks that ordering and rewrites the loader's URL.
       */
      ADS_ENABLED && (
        <>
          <script
            is:inline
            set:html={`window.adsbygoogle=window.adsbygoogle||[];window.adsbygoogle.requestNonPersonalizedAds=1;window.adsbygoogle.tagForChildDirectedTreatment=1;`}
          />
          <script
            is:inline
            async
            crossorigin="anonymous"
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${AD_CLIENT}`}
          />
        </>
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
