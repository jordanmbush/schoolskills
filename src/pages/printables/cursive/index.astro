---
import Content from "@/layouts/Content.astro";
import AdSlot from "@/components/site/AdSlot.astro";
import { JOIN_FAMILIES } from "@/engine/sheets/writing/joins";
import {
  CURSIVE_MODELS,
  CURSIVE_SHEETS,
  STOCKS,
  builderHref,
  cursiveShelf,
  hrefFor,
} from "../_cursive";

/**
 * The cursive subject hub — the third of the §8 names to exist, beside paper,
 * maths and handwriting.
 *
 * A listing rather than a sheet, which makes it one of the pages in this corner
 * that isn't itself printable, and that is the right split: nobody searches for
 * "printable list of cursive worksheets". What it is for is the three jobs a
 * hub does here — giving a parent who landed on one sheet somewhere to go next,
 * giving the topic pages a crawlable parent that says what they have in common,
 * and answering the question the shelf itself cannot: which cursive.
 *
 * That last one is why this hub carries a section the handwriting one does not.
 * Every sheet on the shelf is set in the looped traditional hand because a
 * shelf has to be set in something; the models section is where the other two
 * are offered, each as a link that opens a real sheet on the bench already set
 * to it.
 */
const title =
  "Free printable cursive worksheets — letters, joins and copywork | School Skills";
const description =
  "Printable cursive practice: the alphabet in capitals and small letters, all six families of join, whole words, sentences and copywork. Three cursive models to choose from. Free, no account, and nothing to download.";

const groups = cursiveShelf();
const letter = STOCKS[0];
/** The sheet the model links open on: the alphabet, where a model is visible. */
const [first] = CURSIVE_SHEETS;
/** Found by what it prints rather than by where it sits in the shelf. */
const joins = CURSIVE_SHEETS.find((sheet) => sheet.config.style === "joins")!;
---

<Content
  title={title}
  description={description}
  world="paper"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Printable cursive worksheets",
    description,
    url: "https://schoolskills.app/printables/cursive",
    isAccessibleForFree: true,
    inLanguage: "en",
    hasPart: CURSIVE_SHEETS.map((sheet) => ({
      "@type": "LearningResource",
      name: sheet.heading,
      url: `https://schoolskills.app${hrefFor(sheet, letter)}`,
      learningResourceType: "Worksheet",
      teaches: sheet.teaches,
      typicalAgeRange: sheet.ages,
      isAccessibleForFree: true,
    })),
  }}
>
  <header class="hero wrap">
    <p class="hero__eyebrow">
      <span class="hero__world">The Print Shop</span>
      Cursive
    </p>
    <h1 class="hero__title">Printable cursive worksheets</h1>
    <p class="hero__lead">
      {CURSIVE_SHEETS.length} sheets, from the first joined letter through to copying
      out a poem &mdash; including the one thing printing never needed, which is a
      page of joins. Every sheet traces first, then copies, then leaves an empty line.
    </p>
    <p class="hero__note">Free &middot; two paper sizes &middot; no download</p>
  </header>

  {
    /*
      What exists, first — before the page explains itself. Somebody who came
      looking for cursive joins should be one link from cursive joins, and the
      argument about which hand these are set in reads better after you have
      seen one than before.
    */
  }
  <section class="band band--tight wrap">
    <h2 class="h2">On the shelf now</h2>
    <p class="h2__sub">
      Each of these is a page that is itself the worksheet &mdash; open it,
      press print, and that is the whole of it. Every sheet comes on US Letter
      and on A4, because a ⅝-inch rule shrunk to fit whatever is in the tray is
      no longer a ⅝-inch rule.
    </p>
    {
      groups.map((group) => (
        <>
          <h3 class="h2 h2--next">{group.label}</h3>
          <p class="h2__sub">{group.blurb}</p>
          <div class="prose">
            <ul>
              {group.sheets.map((sheet) => (
                <li>
                  <a href={hrefFor(sheet, letter)}>{sheet.name}</a> &mdash;{" "}
                  {sheet.summary}
                </li>
              ))}
            </ul>
          </div>
        </>
      ))
    }
  </section>

  <div class="wrap"><AdSlot name="article" /></div>

  <section class="band band--inset">
    <div class="wrap">
      <h2 class="h2">Three models, because there is no one cursive</h2>
      <p class="h2__sub">
        The hands taught in different countries disagree about the two things a
        cursive sheet is for: whether an ascender loops, and which letters join.
      </p>
      <div class="prose">
        <ul>
          {
            CURSIVE_MODELS.map((model) => (
              <li>
                <strong>{model.label}</strong> &mdash; {model.blurb}
              </li>
            ))
          }
        </ul>
        <p>
          Picking one and calling it correct would tell somebody&rsquo;s child
          their <em>b</em> joins wrongly, so the model is a choice rather than a decision
          made here. Which letters join to which is written into each face itself,
          so switching the model changes the joins on the page and not just the look
          of them &mdash; a sheet that separates <em>ba</em> in one hand joins it
          in another, and both are right.
        </p>
      </div>
      <div class="hero__actions">
        {
          CURSIVE_MODELS.map((model) => (
            <a
              class="cta cta--quiet"
              href={builderHref(first, letter, model.font)}
            >
              {model.label}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band band--tight wrap">
    <h2 class="h2">The joins, and why they get a page</h2>
    <p class="h2__sub">
      Six families, five pairs each, in the order every scheme teaches them.
    </p>
    <div class="prose">
      <ul>
        {
          JOIN_FAMILIES.map((family) => (
            <li>
              <strong>{family.label}</strong> &mdash; {family.blurb}{" "}
              <em>{family.pairs.join(", ")}</em>
            </li>
          ))
        }
      </ul>
      <p>
        A letter can be practised on its own; a join cannot. The stroke between
        two letters is only correct in the company of the letters either side of
        it, which is why <em>in</em> is a thing to practise and an <em>i</em> next
        to an <em>n</em> is not. It is also why a child who can form every cursive
        letter perfectly can still write a word that falls apart in the middle &mdash;
        the letters were never the missing piece.
      </p>
    </div>
    <div class="hero__actions">
      <a class="cta" href={hrefFor(joins, letter)}>The joins sheet</a>
    </div>
  </section>

  <section class="band band--inset">
    <div class="wrap">
      <h2 class="h2">The ruling is the size it says it is</h2>
      <p class="h2__sub">
        Five handwriting sizes, three notebook rules, and squares, dots and
        triangles &mdash; any of them, with any of the letterforms above.
      </p>
      <div class="prose">
        <p>
          A ⅝-inch rule is ⅝ of an inch under a ruler or it is teaching the
          wrong size of letter, and a child who has been taught to write between
          two lines notices before an adult does. So the lines are drawn as real
          strokes at real distances rather than as a background tint &mdash;
          which also means they survive a printer with &ldquo;background
          graphics&rdquo; unticked, the setting most people never find and the
          reason ruled paper from elsewhere so often comes out blank.
        </p>
        <p>
          Cursive asks one thing more of the paper than print does. In a looped
          hand the tail of a <em>g</em> drops below the baseline and comes back up
          to meet the next letter, so the loop is the road to the following letter
          rather than decoration &mdash; and a model with its loop clipped at the
          line would be teaching a join that stops halfway. The sheets here are ruled
          with a tail space, and the loops are drawn full depth.
        </p>
      </div>
      <div class="hero__actions">
        <a class="cta cta--quiet" href="/printables/handwriting-paper">
          Handwriting paper, ⅝ inch
        </a>
        <a class="cta cta--quiet" href="/printables/lined-paper">
          Lined paper, wide ruled
        </a>
      </div>
    </div>
  </section>

  <section class="band band--tight wrap">
    <h2 class="h2">Printing first, joining after</h2>
    <div class="prose">
      <p>
        Cursive is not where handwriting starts. A child who is still deciding
        which way round a <em>b</em> goes is not ready to join it to anything, and
        the printed sheets are the ones to be on until they are &mdash; the same progression,
        the same rulings, the same trace, copy and write.
      </p>
    </div>
    <div class="hero__actions">
      <a class="cta" href="/printables/handwriting">
        Print handwriting worksheets
      </a>
      <a class="cta cta--quiet" href="/printables">Back to The Print Shop</a>
    </div>
  </section>

  <section class="band band--tight wrap">
    <h2 class="h2">Your own words in a joined hand</h2>
    <div class="prose">
      <p>
        This week&rsquo;s spellings off a school letter, a name to practise, a
        verse to copy out &mdash; the builder takes a typed or pasted list and
        prints it as any of the sheets above, in any of the three models, on any
        ruling, at any size. The settings travel in the link, so a sheet you
        make can be sent to another family as it stands.
      </p>
      <p class="aside">
        The <em>Name:</em> line is printed blank and filled in with a pencil. Nothing
        is uploaded to make a sheet and there is nowhere in a shared link to put a
        child&rsquo;s name &mdash; see <a href="/privacy"
          >what we don&rsquo;t collect</a
        >.
      </p>
    </div>
    <div class="hero__actions">
      <a class="cta" href="/printables/make">Open the sheet builder</a>
    </div>
  </section>
</Content>
