---
import Content from "@/layouts/Content.astro";
import SheetActions from "@/components/site/SheetActions.astro";
import { trailTo } from "../_shelves";
import AdSlot from "@/components/site/AdSlot.astro";
import { SheetView } from "@/components/sheet/Sheet";
import { buildSheet } from "@/engine/sheets";
import {
  PENMANSHIP_SEED,
  PENMANSHIP_SHEETS,
  STOCKS,
  builderHref,
  configFor,
  hrefFor,
  penmanshipShelf,
  type PenmanshipSheet,
} from "../_penmanship";
import type { Stock } from "../_catalog";
import HubLinks from "../_HubLinks.astro";

/**
 * One prerendered penmanship sheet per topic — and the page is the sheet
 * (`docs/printables.md` §8), on a family where the paper *is* the content:
 * prose that answers the query, the sheet itself under it as HTML, and nothing
 * to choose first.
 *
 * **Two stocks, two routes, as with handwriting** (`docs/printables.md` §8).
 * A rest pattern rather than another `[topic]` for the reason that page gives:
 * a two-segment path needs a rest param, and two dynamic patterns at the same
 * level would be two routes claiming one URL.
 *
 * **No answer key.** Nothing on a penmanship sheet has a right answer — the
 * model is already printed, which is the whole exercise — so the family
 * returns its own sheet as the key and the page prints one article.
 *
 * **No client directive on `SheetView`, ever.** A component with no `client:*`
 * is rendered to HTML at build time, so these pages ship zero JavaScript;
 * `Sheet.test.tsx` holds every page in this directory to it.
 *
 * **Everything that is not the sheet carries `.no-print`.** `@page` cannot be
 * scoped to a class, so the zeroed page margin a sheet needs applies to the
 * prose as well and it would print off the edge.
 */

type Props = { sheet: PenmanshipSheet; stock: Stock };

export function getStaticPaths() {
  return PENMANSHIP_SHEETS.flatMap((sheet) =>
    STOCKS.map((stock) => ({
      params: { slug: stock.path ? `${sheet.slug}/${stock.path}` : sheet.slug },
      props: { sheet, stock },
    })),
  );
}

const { sheet, stock } = Astro.props;

const a4 = stock.id === "a4";
const printed = buildSheet(configFor(sheet, stock.id), PENMANSHIP_SEED);
const other = STOCKS.find((candidate) => candidate.id !== stock.id)!;

const heading = a4 ? `${sheet.heading}, for A4` : sheet.heading;
const title = `${sheet.keyword}${a4 ? ", A4" : ""} | School Skills`;
const description = `${sheet.summary} Print it straight from this page on ${stock.label}, or save it as a PDF — free, and no account.`;
const url = `https://schoolskills.app${hrefFor(sheet, stock)}`;

const groups = penmanshipShelf();
const group = groups.find((entry) => entry.id === sheet.group)!;
/** Found by what it prints rather than by where it sits in the shelf. */
const check = PENMANSHIP_SHEETS.find(
  (entry) => entry.config.style === "check",
)!;
---

<Content
  title={title}
  description={description}
  world="paper"
  breadcrumb={trailTo("penmanship", { name: sheet.name, href: url })}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "LearningResource",
    name: heading,
    description,
    url,
    learningResourceType: "Worksheet",
    educationalUse: "Practice",
    teaches: sheet.teaches,
    typicalAgeRange: sheet.ages,
    isAccessibleForFree: true,
    inLanguage: "en",
  }}
>
  <header class="hero wrap no-print">
    <p class="hero__eyebrow">
      <span class="hero__world">The Print Shop</span>
      Penmanship &middot; {group.label}
    </p>
    <h1 class="hero__title">{heading}</h1>
    <p class="hero__lead">{sheet.lead}</p>
    <SheetActions builder={builderHref(sheet, stock)} />
    <p class="hero__note">Free &middot; no account &middot; no download</p>
  </header>

  {
    /*
      The sheet, outside `.wrap` deliberately. A wrap adds an inline padding
      that print.css cannot take back off, and a sheet printed a centimeter in
      from where it says it is has the wrong geometry everywhere at once —
      which on this family is the whole content of the page.
    */
  }
  <div class="sheet-frame">
    <SheetView sheet={printed} />
  </div>

  <section class="band band--tight wrap no-print">
    <h2 class="h2">What is on this sheet</h2>
    <div class="prose">
      {sheet.notes.map((note) => <p>{note}</p>)}
      <p>
        The rules are drawn as real strokes at real sizes, and what goes on them
        is set to the ruling: a letter stands on the baseline and reaches the
        top line, and a stroke pattern is drawn between the same lines the
        letter it belongs to would be. The type size is worked out from the
        ruling and from the font&rsquo;s own measured proportions rather than
        picked to look about right. Put a ruler on it. The ruling is the size it
        says it is.
      </p>
    </div>
  </section>

  <section class="band band--tight wrap no-print">
    <h2 class="h2">Circle the best one</h2>
    <div class="prose">
      <p>
        Practice only improves writing when the child judges it. A row of the
        same letter written ten times is ten letters; a row written five times
        and then looked at, with the best one circled, is a decision about what
        a good letter is &mdash; and the decision is what carries to the next
        page, not the repetitions. Copying is the weakest way to learn a letter,
        writing it from memory after looking at a model is stronger, and judging
        your own against the model is the step that makes the practice count.
      </p>
      <p>
        So use any sheet on this shelf the same way, whether or not it says so.
        Look at the model together and say what makes it right &mdash; where it
        starts, where it stops, how tall it stands. Write, without tracing where
        there is nothing to trace. Then choose: which one is closest, and why.
        The circle-your-best sheet makes that the whole exercise; on the others
        it is the last minute, and the minute that matters.
      </p>
    </div>
    {
      sheet.slug !== check.slug && (
        <div class="hero__actions">
          <a class="cta cta--quiet" href={hrefFor(check, stock)}>
            The circle-your-best sheet
          </a>
        </div>
      )
    }
  </section>

  <section class="band band--tight wrap no-print">
    <h2 class="h2">Printing it on {other.label}</h2>
    <div class="prose">
      <p>
        This sheet is set for {stock.label} &mdash; {stock.size}. Paper size is
        not a preference on a ruled sheet: sent to a printer loaded with
        something else, the browser shrinks the page to fit, and a ruling that
        has been shrunk is no longer the size it was chosen for. So there is a
        second copy of this sheet, ruled identically and measured for {
          other.label
        }.
      </p>
    </div>
    <div class="hero__actions">
      <a class="cta" href={hrefFor(sheet, other)}>The {other.label} version</a>
    </div>
  </section>

  <div class="wrap no-print"><AdSlot name="article" /></div>

  <section class="band band--tight wrap no-print">
    <h2 class="h2">Every penmanship sheet</h2>
    <p class="h2__sub">
      {PENMANSHIP_SHEETS.length} sheets, each one a page like this one. Nothing is
      locked and nothing needs an account.
    </p>
    {
      groups.map((entry) => (
        <>
          <h3 class="h2 h2--next">{entry.label}</h3>
          <p class="h2__sub">{entry.blurb}</p>
          <nav class="stones" aria-label={entry.label}>
            {entry.sheets.map((candidate) => (
              <a
                class="stone"
                href={hrefFor(candidate, stock)}
                aria-current={
                  candidate.slug === sheet.slug ? "page" : undefined
                }
              >
                {candidate.short}
              </a>
            ))}
          </nav>
        </>
      ))
    }
    <div class="hero__actions">
      <a class="cta cta--quiet" href="/printables/penmanship">
        All the penmanship sheets
      </a>
      <a class="cta cta--quiet" href="/printables">Back to The Print Shop</a>
    </div>
  </section>
  <HubLinks shelf="penmanship" />
</Content>
