---
import Content from "@/layouts/Content.astro";

/** Line world, for the same reason as /privacy — see the note on that page. */
const title = "Terms of use — School Skills";
const description =
  "Plain-language terms for using School Skills. Free to use, provided as-is, and your progress is yours.";
const updated = "12 August 2026";
---

<Content title={title} description={description} world="line">
  <header class="hero wrap">
    <p class="hero__eyebrow">
      <span class="hero__world">Terms of use</span>
      Updated {updated}
    </p>
    <h1 class="hero__title">Terms of use</h1>
    <p class="hero__lead">
      Short, because there isn&rsquo;t much to agree to &mdash; there&rsquo;s no
      account, no payment and nothing of yours held anywhere.
    </p>
  </header>

  <section class="band band--tight wrap">
    <div class="prose">
      <h2>Using the site</h2>
      <p>
        School Skills is free for personal, family, classroom and school use.
        Play it, share it, put it on the board &mdash; no permission needed and
        no attribution required.
      </p>

      <h2>Your progress is yours</h2>
      <p>
        Everything the app saves lives in your browser on your device. We never
        receive it, so we can&rsquo;t view it, sell it, lose it, or give it back
        if it&rsquo;s gone. Use the <strong>Back up progress</strong> button if it
        matters to you.
      </p>

      <h2>No warranty</h2>
      <p>
        The site is provided as-is. It&rsquo;s a learning game built with care,
        not a certified assessment tool &mdash; don&rsquo;t rely on it as a
        measure of a child&rsquo;s attainment, and don&rsquo;t rely on the
        browser to keep saved progress forever. Browsers clear storage: in
        private windows always, and on iOS after a period of not visiting the
        site.
      </p>

      <h2>Availability</h2>
      <p>
        There is no guarantee the site stays online or unchanged. Games and
        worlds may be added, altered or removed.
      </p>

      <h2>Content</h2>
      <p>
        The games, text and design are ours. The typefaces are licensed under
        the SIL Open Font License and credited in the repository. The
        mathematics is nobody&rsquo;s &mdash; no one owns the seven times table.
      </p>

      <h2>Changes</h2>
      <p>Last updated {updated}.</p>

      <h2>Contact</h2>
      <p><a href="mailto:hello@schoolskills.app">hello@schoolskills.app</a></p>
    </div>
  </section>
</Content>
