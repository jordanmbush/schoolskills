---
import Content from "@/layouts/Content.astro";
import AdSlot from "@/components/site/AdSlot.astro";

/**
 * One prerendered page per times table — the site's main organic-search
 * surface. "7 times table" is a real, high-volume query with clear intent, and
 * a static HTML page answering it directly is something a crawler can rank on
 * day one; the game behind it is not.
 *
 * Each page carries the full table as a real <table>, a tip that is specific to
 * that number rather than generic filler, and a link into the game. They
 * cross-link to each other so the set is reachable from any entry point.
 *
 * These are the twelve levels of The Grid, and the only numbered sequence on
 * the site — a number IS what distinguishes one of these pages from the next,
 * so the numbering carries information rather than decorating the page.
 */

export function getStaticPaths() {
  return Array.from({ length: 12 }, (_, i) => ({
    params: { table: String(i + 1) },
  }));
}

/** Something true and useful about each specific table, not filler. */
const TIPS: Record<number, string[]> = {
  1: ["Every answer is the number you started with — 1 × 8 is just 8."],
  2: [
    "Doubling. 2 × 7 is 7 + 7.",
    "Every answer is even, so an odd answer means a slip somewhere.",
  ],
  3: [
    "Double it, then add one more group: 3 × 6 is 12 + 6.",
    "The digits of every answer add up to 3, 6 or 9.",
  ],
  4: ["Double twice. 4 × 7 is 7 → 14 → 28."],
  5: [
    "Answers end in 5 or 0, alternating.",
    "Halve the number and multiply by 10: 5 × 8 is half of 8 (4), then 40.",
  ],
  6: [
    "For even numbers the answer ends in the same digit: 6 × 4 = 24, 6 × 6 = 36.",
    "Or take 5 × the number and add one more: 6 × 7 is 35 + 7.",
  ],
  7: [
    "The hardest one for most kids — nothing about it is regular, so it comes down to recall.",
    "Anchor on 7 × 7 = 49 and 7 × 5 = 35, then step out from there.",
  ],
  8: ["Double three times. 8 × 6 is 6 → 12 → 24 → 48."],
  9: [
    "The digits of every answer add to 9: 9 × 6 = 54, and 5 + 4 = 9.",
    "Ten times the number, minus the number: 9 × 7 is 70 − 7.",
    "The finger trick: hold up ten fingers, fold down the nth, and read the two groups.",
  ],
  10: ["Add a zero. 10 × 6 = 60."],
  11: [
    "Up to 9, just repeat the digit: 11 × 4 = 44.",
    "From 10 it changes — 11 × 12 = 132 — which is where it starts needing recall.",
  ],
  12: [
    "Ten times plus two times: 12 × 7 is 70 + 14.",
    "Worth knowing beyond school — clocks, months, inches and dozens all run on 12.",
  ],
};

const { table } = Astro.params;
const n = Number(table);
const rows = Array.from({ length: 12 }, (_, i) => i + 1);
const tips = TIPS[n] ?? [];

const title = `${n} times table — free practice, flash cards and tips | School Skills`;
const description = `The full ${n} times table from ${n} × 1 to ${n} × 12, with tips for remembering it and a free flash-card game to practise. No sign-up, works offline.`;
---

<Content
  title={title}
  description={description}
  world="grid"
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "LearningResource",
    name: `${n} times table`,
    description,
    url: `https://schoolskills.app/multiplication/${n}-times-table`,
    learningResourceType: "Reference",
    educationalLevel: "Elementary School",
    teaches: `Multiplication by ${n}`,
    typicalAgeRange: "5-12",
    isAccessibleForFree: true,
    inLanguage: "en",
  }}
>
  <header class="hero wrap">
    <p class="hero__eyebrow">
      <span class="hero__world">The Grid</span>
      Level {n} of 12
    </p>
    <h1 class="hero__title">The {n} times table</h1>
    <p class="hero__lead">
      Every fact from {n} &times; 1 to {n} &times; 12, what to notice about them,
      and a game for drilling the ones that don&rsquo;t stick.
    </p>
    <div class="hero__actions">
      <a class="cta" href="/flash-cards">Practise the {n}s</a>
    </div>
    <p class="hero__note">Free &middot; no account &middot; works offline</p>
  </header>

  {
    /*
    The table is the answer to the query, so it leads and it stays narrow —
    twelve rows of two numbers don't want a wide column. Everything written
    ABOUT the table sits beside it rather than under it, which is both better
    reading and the difference between a full page and a narrow strip of one.
  */
  }
  <section class="band band--tight wrap">
    <div class="split">
      <div>
        <h2 class="h2">The full table</h2>
        <table class="facts facts--pairs">
          <caption>The {n} times table, 1 to 12</caption>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row">
                    {n} × {r}
                  </th>
                  <td>{n * r}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div>
        {
          tips.length > 0 && (
            <>
              <h2 class="h2">How to remember it</h2>
              <div class="hints">
                {tips.map((tip) => (
                  <p class="hint">
                    <span set:html={tip} />
                  </p>
                ))}
              </div>
            </>
          )
        }

        <h2 class="h2 h2--next">Practising it properly</h2>
        <div class="prose">
          <p>
            Recall and calculation are different skills. A child who works out 7
            &times; 8 by counting up from 7 &times; 4 knows the maths, but
            they&rsquo;ll still stall on it in a longer problem. The goal is
            answering without working it out &mdash; which is why the game times
            every card and treats a slow correct answer as something still worth
            practising.
          </p>
          <p>
            Short and frequent beats long and rare. Five minutes a day moves a
            fact from &ldquo;worked out&rdquo; to &ldquo;known&rdquo; faster
            than half an hour on a Sunday, and it doesn&rsquo;t need
            supervising.
          </p>
          <p class="aside">
            This is drill, not a maths lesson. It won&rsquo;t explain what
            multiplication <em>is</em> and it isn&rsquo;t tied to any curriculum &mdash;
            you teach the {n}s however you teach them, and this is the ten
            minutes afterwards that make them stick.
          </p>
        </div>
        <div class="hero__actions">
          <a class="cta" href="/flash-cards">Start a race</a>
        </div>
      </div>
    </div>
  </section>

  <div class="wrap"><AdSlot name="article" /></div>
  <section class="band band--tight wrap">
    <h2 class="h2">The other levels</h2>
    <p class="h2__sub">
      Twelve tables, no order. Take the one that&rsquo;s giving trouble.
    </p>
    <nav class="stones" aria-label="Times tables">
      {
        rows.map((r) => (
          <a
            class="stone"
            href={`/multiplication/${r}-times-table`}
            aria-current={r === n ? "page" : undefined}
          >
            {r}×
          </a>
        ))
      }
    </nav>
  </section>
</Content>
